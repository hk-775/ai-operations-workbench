# Preserve the upstream PostgreSQL entrypoint and data format; rebuild its
# privilege-drop helper with the patched Go standard library.
FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS helper
ARG GOPROXY=https://proxy.golang.org,direct
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
RUN go install github.com/tianon/gosu@1.20

FROM postgres:16-alpine@sha256:0cefaabd882e42bcb2a2f3dc56d3ce4770560ba62fd7f197f1a2e008fd5731ab
COPY --from=helper /go/bin/gosu /usr/local/bin/gosu
RUN gosu nobody true
