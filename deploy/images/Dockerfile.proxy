FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS builder
ARG GOPROXY=https://proxy.golang.org,direct
ENV CGO_ENABLED=0 GOTOOLCHAIN=local
WORKDIR /build
COPY proxy/go.mod proxy/go.sum ./
RUN go mod download
COPY proxy/*.go ./
COPY proxy/patches/ patches/
# Keep module versions visible to scanners; apply only to the verified v3 source.
RUN go mod vendor \
    && cd vendor/github.com/go-jose/go-jose/v3 \
    && sha256sum -c /build/patches/before.sha256 \
    && patch -p1 < /build/patches/go-jose-v3-CVE-2026-116587.patch \
    && sha256sum -c /build/patches/after.sha256 \
    && cd /build \
    && go test -mod=vendor ./... \
    && go build -mod=vendor -trimpath -o /caddy . \
    && /caddy --workbench-security-self-test

FROM caddy:2-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f
# curl and its libraries are unused by this service.
RUN apk del --no-cache curl
COPY --from=builder /caddy /usr/bin/caddy
