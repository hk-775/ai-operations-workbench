<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram name="Implemented local workflow" id="workbench"><mxGraphModel dx="1280" dy="720" grid="1" gridSize="10" page="1" pageWidth="1280" pageHeight="720"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="From recorded usage to a reviewable decision." style="text;html=1;align=left;fontSize=29;fontStyle=1;fontColor=#1c1917;" vertex="1" parent="1"><mxGeometry x="60" y="18" width="1160" height="45" as="geometry" /></mxCell><mxCell id="subtitle" value="IMPLEMENTED LOCAL ARCHITECTURE · AI OPERATIONS WORKBENCH v0.1.0" style="text;html=1;align=left;fontSize=15;fontColor=#57534e;" vertex="1" parent="1"><mxGeometry x="60" y="64" width="1160" height="28" as="geometry" /></mxCell><mxCell id="source" value="&lt;b&gt;Recorded usage&lt;/b&gt;&lt;br&gt;&lt;br&gt;Fictional cases · actual model responses&lt;br&gt;144 calls · 24 cases · 3 model snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;fontColor=#1c1917;fontSize=16;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="160" width="320" height="140" as="geometry" /></mxCell><mxCell id="ledger" value="&lt;b&gt;Validated local ledger&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schema, cost checks, and deduplication&lt;br&gt;SQLite · one active recording" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#bae6fd;fontColor=#1c1917;fontSize=16;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="475" y="160" width="320" height="140" as="geometry" /></mxCell><mxCell id="ui" value="&lt;b&gt;Workbench UI&lt;/b&gt;&lt;br&gt;&lt;br&gt;Inspect tasks, calls, and API estimates&lt;br&gt;FastAPI + browser · localhost only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fefce8;strokeColor=#facc15;fontColor=#1c1917;fontSize=16;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="160" width="320" height="140" as="geometry" /></mxCell><mxCell id="checks" value="&lt;b&gt;Contract checks + Ostiari&lt;/b&gt;&lt;br&gt;&lt;br&gt;Decision correctness and critical failures&lt;br&gt;Actual Ostiari Guard · draft-only policy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#ddd6fe;fontColor=#1c1917;fontSize=16;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="320" height="140" as="geometry" /></mxCell><mxCell id="worker" value="&lt;b&gt;Offline replay worker&lt;/b&gt;&lt;br&gt;&lt;br&gt;Read and regrade saved responses&lt;br&gt;No model API calls during replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#ddd6fe;fontColor=#1c1917;fontSize=16;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="475" y="400" width="320" height="140" as="geometry" /></mxCell><mxCell id="proposal" value="&lt;b&gt;Routing proposal&lt;/b&gt;&lt;br&gt;&lt;br&gt;Quality, critical failures, latency, cost&lt;br&gt;Export evidence · no route activation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fdfa;strokeColor=#99f6e4;fontColor=#1c1917;fontSize=16;spacing=18;arcSize=12;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="320" height="140" as="geometry" /></mxCell><mxCell id="edge-0" value="import" source="source" target="ledger" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#78716c;fontColor=#57534e;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-1" value="inspect" source="ledger" target="ui" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#78716c;fontColor=#57534e;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-2" value="replay" source="ledger" target="worker" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#78716c;fontColor=#57534e;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-3" value="evaluate" source="worker" target="checks" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#78716c;fontColor=#57534e;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-4" value="compare" source="worker" target="proposal" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#78716c;fontColor=#57534e;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge-5" value="review" source="proposal" target="ui" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#78716c;fontColor=#57534e;fontSize=12;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="collection" value="&lt;b&gt;Optional fresh collection · paid and explicitly budgeted&lt;/b&gt;&lt;br&gt;&lt;br&gt;Collection CLI → Ostiari Guard → AxonLLM → external model API → new recording.&lt;br&gt;Browser replay never runs this path." style="rounded=1;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#d6d3d1;fontColor=#57534e;fontSize=14;spacing=14;align=left;" vertex="1" parent="1"><mxGeometry x="60" y="594" width="1160" height="83" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>